# Banco de dados — PostgreSQL local via Docker
DATABASE_URL="postgresql://contador:contador_dev@localhost:5432/pergunteaosecontador"

# Segredo pra assinar os tokens JWT (troque por uma string longa e aleatória em produção)
JWT_SECRET="troque-por-segredo-longo-e-aleatorio-aqui"

# ─── Provider de IA ───────────────────────────────────────────────────────────
# Escolha: anthropic | gemini
AI_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Google Gemini (https://ai.google.dev)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Redis ────────────────────────────────────────────────────────────────────
# Já vem no docker-compose. Em produção: URL do Upstash ou Railway
REDIS_URL=redis://localhost:6379

# ─── Limites de uso ───────────────────────────────────────────────────────────
DAILY_GLOBAL_LIMIT=200
DAILY_USER_LIMIT=5
MIN_SECONDS_BETWEEN_MESSAGES=8

# ─── Alertas (opcional) ───────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ─── Integrações — Booking + Pagamento ───────────────────────────────────────
# Troque MODE de "mock" para "real" quando tiver as credenciais de produção.
# Com MODE=mock, nenhuma chamada externa é feita e todos os dados são simulados.

# Cal.com (agendamento de slots)
# Credencial: https://app.cal.com/settings/developer/api-keys
CALCOM_MODE=mock
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Kiwify (processamento de pagamento)
# Credencial: https://dashboard.kiwify.com.br/settings/integrations
KIWIFY_MODE=mock
KIWIFY_PUBLIC_KEY=
KIWIFY_SECRET_KEY=
KIWIFY_PRODUCT_ID=7CyqdEm
KIWIFY_WEBHOOK_SECRET=

# Resend (envio de e-mails transacionais)
# Credencial: https://resend.com/api-keys
RESEND_MODE=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=contato@pergunteaoseucontador.com.br

# Produto
SESSION_PRICE_CENTS=19700
SESSION_DURATION_MINUTES=60
